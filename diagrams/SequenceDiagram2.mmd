%% config
autonumber
actor user as User
participant controller as controller : GameController
participant saveManager as saveManager : SaveManager
participant factory as factory : GameFactory
participant game as loadedGame : GomokuGame
participant board as board : Board
participant history as history : MoveHistory
participant computer as computer : ComputerPlayer

%% steps
%% load the saved game
Note over saveManager,game: The save has four moves, cursor 3, and in-progress HUMAN_VS_COMPUTER Gomoku game.
user->>controller: L (Load command)
controller->>controller: LoadGame()
controller->>saveManager: LoadGame()
saveManager->>factory: CreateGame(GOMOKU, HUMAN_VS_COMPUTER, 15)
factory-->>saveManager: loadedGame

%% restore saved history
loop Four saved moves in order
    saveManager->>saveManager: FindReplayMove(loadedgame, savedMove)
    Note over saveManager,game: The matched move uses a player's owned MarkPiece.
    saveManager->>game: MakeMove(move)
    game->>board: PlaceMove(move)
    game->>history: AddMove(move)
    game->>game: EvaluateResult()
end
Note over game,history: After replay, cursor is 3, human is next, result is IN_PROGRESS.
saveManager->>controller: loadedGame

%% game restored and playable
user->>controller: U (undo command)
controller->>game: UndoMove()
game->>board: RemoveMove(move4)
game->>computer: RestorePiece(move4.GetPiece())
game->>history: UndoLastMove()
game->>game: EvaluateResult()
game-->>controller: true
Note over game,history: Cursor is 2, computer next, Result is IN_PROGRESS, move4 remains available for redo.
controller->>controller: DisplayGame()