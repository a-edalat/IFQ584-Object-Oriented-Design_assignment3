%% class and method implementations
class Program {
    -Main(): void
}


class Piece {
    <<abstract>>
    +DisplayValue(): string
    +IsReusable(): bool
}

class NumberPiece {
    -_value: int
    +Value: int
    +NumberPiece(value: int)
    +DisplayValue(): string
    +IsReusable(): bool
}

class MarkPiece {
    -_symbol: string
    +Symbol: string
    +MarkPiece(symbol: string)
    +DisplayValue(): string
    +IsReusable(): bool
}

class Player {
    <<abstract>>
    -_availablePieces: List~Piece~
    +Id: int
    +Name: string
    +AvailablePieces: IReadOnlyList~Piece~
    #Player(id: int, name: string, availablePieces: List~Piece~)
    +HasPiece(piece: Piece): bool
    +UsePiece(piece: Piece): bool
    +RestorePiece(piece: Piece): void
    +IsComputer(): bool
}

class HumanPlayer {
    +HumanPlayer(id: int, name: string, availablePieces: List~Piece~)
    +IsComputer(): bool
}

class ComputerPlayer {
    -_strategy: MoveStrategy
    +ComputerPlayer(id: int, name: string, availablePieces: List~Piece~, strategy: MoveStrategy)
    +ChooseMove(game: Game): Move
    +IsComputer(): bool
}

class MoveStrategy {
    <<interface>>
    +ChooseMove(game: Game, player: Player): Move
}

class WinningThenRandomStrategy {
    -_random: Random
    +WinningThenRandomStrategy(random: Random?)
    +ChooseMove(game: Game, player: Player): Move
}

class Move {
    -player: Player
    -boardIndex: int
    -row: int
    -column: int
    -piece: Piece
    +Move(player: Player, boardIndex: int, row: int, column: int, piece: Piece)
    +GetPlayer(): Player
    +GetBoardIndex(): int
    +GetRow(): int
    +GetColumn(): int
    +GetPiece(): Piece
}

class MoveHistory {
    -moves: List~Move~
    -currentMoveIndex: int
    +MoveHistory(moves: List~Move~, currentMoveIndex: int)
    +ClearRedoHistory(): void
    +AddMove(Move move): void
    +GetMoves(): List<Move>
    +GetCurrentIndex(): int
    +UndoLastMove(): Move
    +RedoLastMove(): Move
}

class Board {
    -rows: int
    -cols: int
    -cells: Piece?[]
    +Board(rows: int, cols: int)
    +IsWithinBoard(row: int, col: int): bool
    +HasSize(expectedRows: int, expectedColumns: int): bool
    +IsCellEmpty(row: int, col: int): bool
    +PlaceMove(move: Move): void
    +RemoveMove(move: Move): void
    +IsFull(): bool
    -SetCell(row: int, column: int, piece: Piece?): void
    +GetCell(row: int, column: int): Piece?
    +GetDimensions(): (int Rows, int Columns)
}

class Game {
    <<abstract>>
    -_boards: List~Board~
    -_players: List~Player~
    -_moveHistory: MoveHistory
    -_currentPlayer: Player
    +Mode: GameMode
    +Result: GameResult
    +IsGameOver: bool
    +Boards: IReadOnlyList~Board~
    +Players: IReadOnlyList~Player~
    +Moves: IReadOnlyList~Move~
    +CurrentMoveIndex: int
    +Game(players: List~Player~, boards: List~Board~, mode: GameMode)
    #IsValidMove(move: Move): bool
    +MakeMove(move: Move): bool
    +UndoMove(): bool
    +RedoMove(): bool
    #SwitchPlayer(): void
    +GetCurrentPlayer(): Player
    +GetValidMoves(): List~Move~
    +WouldMoveWin(move: Move): bool
    +EvaluateResult(): GameResult
    +GetHelpText(): string
}

class NumericalTTTGame {
    -_board: Board
    -_players: List~Player~
    +MaxBoardSize: int
    +BoardSize: int
    +TargetSum: int
    +NumericalTTTGame(players: List~Player~, board: Board, mode: GameMode)
    -ValidatePlayers(players: List~Player~): List~Player~
    -ValidatePlayerNumbers(player: Player, shouldBeOdd: bool, playerName: string): void
    -CreateBoardList(board: Board): List~Board~
    -GetBoardSize(board: Board): int
    +GetValidMoves(): List~Move~
    -GetAvailableNumbers(player: Player): List~NumberPiece~
    #IsValidMove(move: Move): bool
    -PlayerOwnsNumber(player: Player, value: int): bool
    -IsNumberUnused(value: int): bool
    +WouldMoveWin(move: Move): bool
    -HasWinningLine(): bool
    -CheckLineSum(startingRow: int, startingColumn: int, rowChange: int, columnChange: int): bool
    +EvaluateResult(): GameResult
    -GetCurrentPlayerWinResult(): GameResult
    +GetHelpText(): string
}

class NotaktoGame {
    +RequiredBoards: int
    +BoardSize: int
    -_boards: List~Board~
    -_players: List~Player~
    -_inactiveBoards: List~int~
    -_symbol: string
    +InactiveBoards: IReadOnlyList~int~
    +NotaktoGame(players: List~Player~, boards: List~Board~, mode: GameMode)
    -ValidatePlayers(players: List~Player~): List~Player~
    -ValidateBoards(boards: List~Board~): List~Board~
    -GetPlayerMark(player: Player): MarkPiece
    +GetValidMoves(): List~Move~
    #IsValidMove(move: Move): bool
    -CheckBoardHasLine(board: Board): bool
    -CheckLine(board: Board, startingRow: int, startingColumn: int, rowChange: int, columnChange: int): bool
    -RefreshInactiveBoards(): void
    +WouldMoveWin(move: Move): bool
    +EvaluateResult(): GameResult
    +GetHelpText(): string
}

class GomokuGame {
    +BoardSize: int
    +WinningLength: int
    -_board: Board
    -_players: List~Player~
    -Directions: (int Row, int Column)[]
    +GomokuGame(players: List~Player~, board: Board, mode: GameMode)
    -ValidatePlayers(players: List~Player~): List~Player~
    -ValidatePlayerMarks(): void
    -GetPlayerMark(player: Player): MarkPiece
    -CreateBoardList(board: Board): List~Board~
    +GetValidMoves(): List~Move~
    #IsValidMove(move: Move): bool
    +WouldMoveWin(move: Move): bool
    -HasWinningLine(row: int, column: int, symbol: string): bool
    -CountDirection(startingRow: int, startingColumn: int, rowChange: int, columnChange: int, symbol: string): int
    +EvaluateResult(): GameResult
    -GetWinResult(winningSymbol: string): GameResult
    +GetHelpText(): string
}

class GameFactory {
    +CreateGame(gameType: GameType, gameMode: GameMode, boardSize: int): Game
    -CreateNumericalTTTGame(mode: GameMode, boardSize: int): NumericalTTTGame
    -CreateNotaktoGame(mode: GameMode, boardSize: int): NotaktoGame
    -CreateGomokuGame(mode: GameMode, boardSize: int): GomokuGame
    -CreatePlayers(mode: GameMode, playerOnePieces: List~Piece~, playerTwoPieces: List~Piece~): List~Player~
    -ValidateBoardSize(boardSize: int, requiredSize: int, gameName: string): void
}

class SaveManager {
    -filePath: string
    -gameFactory: GameFactory 
    +SaveManager(filePath: string, gameFactory: GameFactory)
    +SaveGame(game: Game): void
    +LoadGame(): Game
    +FileExists(): bool
    -FindReplayMove(game: Game, savedMove: JsonElement): Move?
    -ReadInt(item: JsonElement, propertyName: string): int
    -ReadBool(item: JsonElement, propertyName: string): bool
    -ReadString(item: JsonElement, propertyName: string): string
}

class Help {
    +Display(game: Game?): void
}

class GameController {
    -currentGame: Game?
    -saveManager: SaveManager
    -help: Help
    -gameFactory: GameFactory
    +GameController(saveManager: SaveManager, help: Help, gameFactory: GameFactory)
    +Run(): void
    +StartNewGame(): void
    +LoadGame(): void
    +SelectGameType(): string
    +SelectGameMode(): string
    +SelectBoardSize(gameType: string): int
    +CreateGame(gameType: string, gameMode: string, boardSize: int): Game
    -FindHumanMove(game: Game, boardNumber: int, rowNumber: int, columnNumber: int, value: string?): Move?
    -ReadHumanMove(game: Game): Move?
    -MakeCurrentPlayerMove(): void
    +HandleCommand(command: string): void
    +DisplayGame(): void
    +DisplayResult(): void
    -DisplayBoards(game: Game): void
}

%% connections
%% inheritance
Piece <|-- NumberPiece
Piece <|-- MarkPiece

Player <|-- HumanPlayer
Player <|-- ComputerPlayer

MoveStrategy <|.. WinningThenRandomStrategy

Game <|-- NumericalTTTGame
Game <|-- NotaktoGame
Game <|-- GomokuGame

%% aggegation and composition
Player "1" o-- "0..*" Piece : owns

ComputerPlayer "1" *-- "1" MoveStrategy : uses

Game "1" *-- "1..3" Board : owns
Game "1" *-- "2" Player : participants
Game "1" *-- "1" MoveHistory : history

GameController "1" --> "1" Help : displays guidance

Board "1" o-- "0..*" Piece : cell contents

MoveHistory "1" *-- "0..*" Move : records

%% dependency
GameFactory ..> Game : creates configured game
GameFactory ..> Board : creates
GameFactory ..> Player : creates
GameFactory ..> MoveStrategy : configures

Help ..> Game : displays help for

Program ..> GameController : starts
Program ..> SaveManager : constructs
Program ..> Help : constructs
Program ..> GameFactory : constructs

GameController "1" o-- "0..1" Game : current game

%% directed association
GameController --> GameFactory
GameController --> SaveManager

SaveManager --> GameFactory : reconstructs with
SaveManager --> Game : saves and loads

Move --> "1" Player : made by
Move --> "1" Piece : places