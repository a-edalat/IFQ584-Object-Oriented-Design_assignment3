%% connections
%% association
controller --> saveLoadService : loads through
controller --> factory : uses

saveLoadService --> factory : reconstructs through
%% dependency
saveLoadService ..> loadedGame : restores

move1 --> gomokuBoard : targets
move2 --> gomokuBoard : targets
move3 --> gomokuBoard : targets
move4 --> gomokuBoard : targets

%% composition
computer *-- strategy : uses

loadedGame *-- gomokuBoard : board 0
loadedGame *-- human : current player
loadedGame *-- computer : player 2
loadedGame *-- history : move history

history *-- move1 : first
history *-- move2 : second
history *-- move3 : third
history *-- move4 : fourth - next undo

%% aggregation
controller o-- loadedGame : current game

human o-- humanMark : owns reusable mark

computer o-- computerMark : owns reusable mark

gomokuBoard o-- humanMark : cells 7,7 and 8,8
gomokuBoard o-- computerMark : cells 7,8 and 6,6