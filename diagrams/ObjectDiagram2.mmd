%% diag type
classDiagram
direction TB

%% formatting for space constraints
%%{init: {"layout": "elk", "class": {"hideEmptyMembersBox": true, "nodeSpacing": 25, "rankSpacing": 35, "diagramPadding": 8, "useMaxWidth": true}}}%%

%% classes

class controller["controller : GameController"] {
    currentGame = loadedGame
    saveManager = saveManager
    help = help
    gameFactory = factory
}

class saveManager["saveManager : SaveManager"] {
    filePath = current-directory/board-game-save.json
    gameFactory = factory
}

class help["help : Help"]
class factory["factory : GameFactory"]

class loadedGame["loadedGame : GomokuGame"] {
    Mode = HUMAN_VS_COMPUTER
    Result = IN_PROGRESS
    GomokuGame._board = gomokuBoard
    GomokuGame._players = [human, computer]
    _moveHistory = history
    _currentPlayer = human
}

class gomokuBoard["gomokuBoard : Board"] {
    rows = 15
    cols = 15
    cells = Piece?[225]
    cells[96] = computerMark
    cells[112] = humanMark
    cells[113] = computerMark
    cells[128] = humanMark
}
note for gomokuBoard "Occupied cells are (6,6) = O, (7,7) = X, (7,8) = O, (8,8) =X."

class human["human : HumanPlayer"] {
    Id = 1
    Name = Player 1
    _availablePieces = [humanMark]
}

class computer["computer : ComputerPlayer"] {
    Id = 2
    Name = Computer
    _availablePieces = [computerMark]
    _strategy = strategy
}

class humanMark["humanMark : MarkPiece"] {
    Symbol = X
}

class computerMark["computerMark : MarkPiece"] {
    Symbol = O
}

class strategy["strategy : WinningThenRandomStrategy"] {
    _random = Random.Shared
}

class history["history : MoveHistory"] {
    moves = [move1, move2, move3, move4]
    currentMoveIndex = 3
}
note for history "UndoLastMove returns move4"

class move1["move1 : Move"] {
    player = human
    boardIndex = 0
    row = 7
    column = 7
    piece = humanMark
}

class move2["move2 : Move"] {
    player = computer
    boardIndex = 0
    row = 7
    column = 8
    piece = computerMark
}

class move3["move3 : Move"] {
    player = human
    boardIndex = 0
    row = 8
    column = 8
    piece = humanMark
}

class move4["move4 : Move"] {
    player = computer
    boardIndex = 0
    row = 6
    column = 6
    piece = computerMark
}

%% connections
%% association
controller --> loadedGame : current game
controller --> saveManager
controller --> help
controller --> factory

saveManager --> factory : reconstructs with

move1 --> human : player
move1 --> humanMark : piece
move2 --> computer : player
move2 --> computerMark : piece
move3 --> human : player
move3 --> humanMark : piece
move4 --> computer : player
move4 --> computerMark : piece

%% composition
loadedGame *-- history : history

%% aggregation
loadedGame o-- gomokuBoard : board 0
loadedGame o-- human : current player
loadedGame o-- computer : player 2

computer o-- strategy : strategy
computer o-- computerMark : reusable mark

human o-- humanMark : reusable mark

gomokuBoard o-- humanMark : cells 112 and 128
gomokuBoard o-- computerMark : cells 96 and 113

history o-- move1 : first
history o-- move2 : second
history o-- move3 : third
history o-- move4 : fourth - next undo