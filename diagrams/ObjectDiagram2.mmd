%% classes

class controller["controller : GameController"] {
    <<incomplete>>
    _currentGame = loadedGame
    _factory = factory
    _saveLoadService = saveLoadService
}

class saveLoadService["saveLoadService : SaveLoadService"] {
    <<incomplete>>
    _factory = factory
    _filePath = gomoku-save.json
}
note for saveLoadService "Loading and reconstruction are not implemented yet."

class factory["factory : GameFactory"]

class loadedGame["loadedGame : GomokuGame"] {
    BoardSize = 15
    WinningLength = 5
    Mode = HUMAN_VS_COMPUTER
    Result = IN_PROGRESS
    IsGameOver = false
    _currentPlayer = human
}

class gomokuBoard["gomokuBoard : Board"] {
    Rows = 15
    Columns = 15
    cell7_7 = humanMark
    cell7_8 = computerMark
    cell8_8 = humanMark
    cell6_6 = computerMark
    all other cells = empty
}
note for gomokuBoard "Typed Piece cells and public dimensions TBC - current Board stores integers."

class human["human : HumanPlayer"] {
    Id = 1
    Name = Player 1
    AvailablePieces = [humanMark]
}

class computer["computer : ComputerPlayer"] {
    Id = 2
    Name = Computer
    AvailablePieces = [computerMark]
    _strategy = strategy
}

class humanMark["humanMark : MarkPiece"] {
    Symbol = X
}

class computerMark["computerMark : MarkPiece"] {
    Symbol = O
}

class strategy["strategy : WinningThenRandomStrategy"]

class history["history : MoveHistory"] {
    <<incomplete>>
    _currentMoveIndex = 3
    _moves = [move1, move2, move3, move4]
}
note for history "move4 can be undone immediately; no new move is needed."

